rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["telefone", "updatedAt"]);

      match /notificacoes/{notificacaoId} {
        allow read: if request.auth != null &&
          request.auth.uid == userId;

        allow create: if request.auth != null &&
          request.resource.data.destinatarioId == userId &&
          request.resource.data.lida == false;

        allow update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["lida", "lidaEm"]) &&
          request.resource.data.lida == true;

        allow delete: if false;
      }
    }

    match /recursos/{resourceId} {
      allow read, write: if request.auth != null;

      match /eventosAuditoria/{eventoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    match /chaves/{chaveId} {
      allow read, write: if request.auth != null;
    }

    match /movimentacoes/{movimentacaoId} {
      allow read, write: if request.auth != null;
    }

    match /{path=**}/eventosAuditoria/{eventoId} {
      allow read: if request.auth != null;
    }

    match /solicitacoes/{solicitacaoId} {
      allow read, write: if request.auth != null;

      match /eventosAuditoria/{eventoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }
  }
}
